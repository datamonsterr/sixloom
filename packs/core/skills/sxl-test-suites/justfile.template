# sixloom task runner: humans, agents and CI all call these targets.
# One block of recipes per interface and per service from `sixloom layout`; folders below
# are examples (interface `web` at apps/web, service `api` at services/api). Replace the
# <...> commands with your stack's (see system-design ADRs). Keep the target names:
# skills, CI and `sixloom` call preview, dev, lint, typecheck, unit, contract, e2e, ci-fast, ci.

set dotenv-load := true

default:
    @just --list

# ---- dev ---------------------------------------------------------------
# Front end on mocks: the product preview
preview:
    cd apps/web && <npm run preview>          # one line per interface; TUI: SXL_API_MODE=mock cargo run -p tui

# Full stack: web against the real API
dev:
    <docker compose up -d db>
    <cd services/api && run dev> &
    cd apps/web && VITE_API_MODE=real <pnpm dev>

docs:
    cd docs && <pnpm dev>

# ---- checks ------------------------------------------------------------
lint:
    cd apps/web && <pnpm lint>
    cd services/api && <lint>

typecheck:
    cd apps/web && <pnpm typecheck>
    cd services/api && <typecheck>

unit:
    cd apps/web && <pnpm test --run>
    cd services/api && <test>

contract:
    <start api in test mode> && <pnpm -C tests playwright test contract integration>

e2e-mock *args:
    E2E_MODE=mock <pnpm -C tests playwright test e2e> {{args}}

e2e *args:
    E2E_MODE=real <pnpm -C tests playwright test e2e> {{args}}

# The fast gate: run this before every push
ci-fast: lint typecheck unit
    sixloom tests verify

ci: ci-fast contract e2e
